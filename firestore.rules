rules_version = '2';

// Security rules for Ease Your Mind household sharing.
// Paste these into Firebase console -> Firestore Database -> Rules.
service cloud.firestore {
  match /databases/{database}/documents {
    match /households/{householdId} {
      function members() {
        return resource.data.members;
      }
      function isMember() {
        return request.auth != null && request.auth.uid in members();
      }
      // Someone holding the invite code may read the household and add
      // themselves to the member list while there is room.
      function isJoining() {
        return request.auth != null
          && members().size() < 4
          && request.resource.data.members.hasAll(members())
          && request.resource.data.members.size() == members().size() + 1
          && request.auth.uid in request.resource.data.members;
      }
      // Leaving only ever removes the caller.
      function isLeaving() {
        return isMember()
          && !(request.auth.uid in request.resource.data.members)
          && members().removeAll([request.auth.uid]) == request.resource.data.members;
      }

      allow get: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.members == [request.auth.uid];
      allow update: if isMember() || isJoining() || isLeaving();
      allow delete: if false;
      allow list: if false;
    }
  }
}
