rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: only the authenticated user may read/write their own document
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Households: membership-managed access
    match /households/{householdId} {
      function members() { return resource.data.members; }
      function isMember() { return request.auth != null && request.auth.uid in members(); }
      function isJoining() {
        // client may add themselves in a single update: new members list must contain previous members
        return request.auth != null
          && request.resource.data.members.size() == members().size() + 1
          && request.resource.data.members.hasAll(members())
          && request.auth.uid in request.resource.data.members;
      }
      function isLeaving() {
        // client may remove themselves
        return isMember()
          && !(request.auth.uid in request.resource.data.members)
          && members().removeAll([request.auth.uid]) == request.resource.data.members;
      }

      // Only household members may read household metadata
      allow get: if isMember();
      // Creation must initialize members to the creating user only
      allow create: if request.auth != null && request.resource.data.members == [request.auth.uid];
      // Members may update household; also allow controlled join/leave updates as above
      allow update: if isMember() || isJoining() || isLeaving();
      allow delete: if false;
      allow list: if false;
    }

    // Gifts inside a household
    match /households/{householdId}/gifts/{giftId} {
      function householdMembers() {
        return get(/databases/$(database)/documents/households/$(householdId)).data.members;
      }

      // Read allowed for household members and only for shared gifts or gifts they created
      allow read: if request.auth != null
        && request.auth.uid in householdMembers()
        && (resource.data.visibility == 'shared' || resource.data.createdBy == request.auth.uid);

      // Create allowed for household members. createdBy must match request.auth.uid.
      allow create: if request.auth != null
        && request.auth.uid in householdMembers()
        && request.resource.data.createdBy == request.auth.uid
        && (request.resource.data.visibility == 'shared' || request.resource.data.visibility == 'private');

      // Update/delete allowed for creator or household owner only
      allow update, delete: if request.auth != null
        && request.auth.uid in householdMembers()
        && (resource.data.createdBy == request.auth.uid || request.auth.uid == get(/databases/$(database)/documents/households/$(householdId)).data.ownerUid);
    }

    // Invites must be handled by server-side Cloud Functions (admin SDK). Deny client access.
    match /householdInvites/{inviteId} {
      allow read, write: if false;
    }
  }
}
